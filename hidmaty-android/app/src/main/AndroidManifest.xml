<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- الإنترنت — إلزامي بالطبع -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- الموقع الجغرافي — يستخدمه الموقع لعرض الخرائط وموقع تنفيذ الخدمة -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- الكاميرا — لرفع صور (تنفيذ الخدمة، إثبات نزاع، صورة شخصية) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- إشعارات (أندرويد 13+ يتطلّبها صراحة) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".HidmatyApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Hidmaty"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Hidmaty.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize" />

        <!-- FileProvider — ضروري لالتقاط صورة بالكاميرا من داخل WebView (بدونه
             رفع الصور بالكاميرا يفشل بصمت على أندرويد 7+) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.hidmaty.app.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
