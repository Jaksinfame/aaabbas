<?xml version="1.0" encoding="utf-8"?>
<!--
    هذا الملف يُدمَج تلقائياً مع AndroidManifest.xml الرئيسي، لكن فقط
    عند بناء نسخة "debug" (اللي تشغّلها من Android Studio بزر ▶ العادي).
    نسخة "release" (اللي تبنيها فعلياً للنشر لاحقاً) لا تتأثر بهذا الملف
    إطلاقاً — تبقى https إلزامية بلا استثناء.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:networkSecurityConfig="@xml/network_security_config_debug"
        tools:replace="android:networkSecurityConfig"
        xmlns:tools="http://schemas.android.com/tools" />
</manifest>
